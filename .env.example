# ---------------------------------------------------------------------------
# Restyle — environment. Copy to .env.local and fill in.
# .env.local is gitignored and MUST NEVER be committed.
# ---------------------------------------------------------------------------

# Public site origin. Used for canonical URLs, OG images, sitemap and email links.
# Must be the real origin in production or every absolute URL ships wrong.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project URL and publishable (anon) key. Safe to expose to the browser; every
# table is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# Server-only. BYPASSES RLS COMPLETELY. Used by seeds, cron routes and admin
# service paths, each of which does its own authorization check. Never expose
# to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Email address that is granted the admin role at profile creation.
ADMIN_EMAIL=

# --- Payments ---------------------------------------------------------------
# mock    — local fake PSP at /pay/mock/[orderId]; the whole purchase flow is
#           testable with no credentials. This is the default.
# payplus — PayPlus adapter (skeleton; see src/lib/payments/payplus.ts)
# sumit   — Sumit adapter (skeleton; the PSP the legacy app used)
PAYMENT_PROVIDER=mock

PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAGE_UID=

SUMIT_API_KEY=
SUMIT_COMPANY_ID=

# --- AI listing drafts ------------------------------------------------------
# When false (or the key is absent) the sell wizard uses a deterministic
# fixture, so the flow stays fully testable without a key.
AI_LISTING_ENABLED=false
ANTHROPIC_API_KEY=

# --- Email ------------------------------------------------------------------
# mock   — logs a table to the console; nothing is sent.
# resend — real delivery via Resend.
EMAIL_PROVIDER=mock
RESEND_API_KEY=

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_GA_ID=

# --- Cron -------------------------------------------------------------------
# Bearer token guarding /api/cron/*. Generate with: openssl rand -hex 32
# These endpoints cancel orders and issue refunds — an unguarded one is a
# public endpoint that can move money.
CRON_SECRET=
